# OpenAI Configuration
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Database
DATABASE_URL=mongodb://localhost:27017/shadow-ai

# Server
PORT=3000
NODE_ENV=development

# Cloud AI Service
CLOUD_AI_ENABLED=true
CLOUD_AI_TIMEOUT=5000

# Offline Engine
OFFLINE_MODEL_PATH=./models/mistral-7b-q4.gguf
OFFLINE_ENABLED=true

# Memory Graph
MEMORY_GRAPH_DB=./data/memory.db

# Auth
JWT_SECRET=your-secret-key-here
JWT_EXPIRY=24h

# Plugins
PLUGIN_DIR=./plugins
PLUGIN_ENABLED=true
